# Origem canônica do site. Alimenta metadataBase, sitemap, robots e Open Graph.
# Sem isto, toda URL canônica nasce apontando para o domínio errado.
NEXT_PUBLIC_SITE_URL=https://quantical.com.br

# Supabase (opcional). Sem estas variáveis a Quantical funciona por inteiro em
# modo local, salvando progresso e projetos no próprio navegador.
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-publica
